# Copy to .env and fill in. All values can also be set as environment variables.

# Elasticsearch
ES_HOST=https://localhost:9200
ES_USER=elastic
ES_PASSWORD=changeme
ES_CA_CERTS=../Autocomplete-new/config/ca.crt
ES_VERIFY_CERTS=true
INDEX_NAME=places
SYNONYM_SET_ID=places_synonyms

# App / serving
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false

# Access control
ALLOWED_ORIGINS=*            # CORS; comma-separated list, or *
ALLOWED_IPS=                 # client IP allowlist; empty = allow all; comma-separated IPs/CIDRs
API_KEYS=                    # x-api-key header auth; comma-separated keys; empty = no auth (dev)

# Postgres (indexer source)
DB_HOST=localhost
DB_PORT=5432
DB_USER=dbuser
DB_PASSWORD=
DB_NAME=dbname

# Mongo (optional synonym source)
MONGO_URI=
MONGO_DB=mongodb
